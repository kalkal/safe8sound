{
  "name": "cold-reserve",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "Voice agent that turns a home battery into a comfort reserve.",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "prepare": "node tooling/src/install-hooks.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui-cards && tsc -p apps/alexa-sim",
    "lint": "eslint --max-warnings=0 .",
    "lint:css": "stylelint \"**/*.css\" --cache --cache-location node_modules/.cache/stylelint/",
    "depcruise": "depcruise --config .dependency-cruiser.cjs --cache node_modules/.cache/depcruise packages apps infra tooling",
    "test": "vitest run",
    "tokens": "pnpm --filter @cold-reserve/design-tokens build",
    "synth": "pnpm --filter @cold-reserve/alexa-sim build:aws && pnpm --filter @cold-reserve/infra synth",
    "heavy": "node tooling/src/heavy.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:css && pnpm depcruise && pnpm --filter @cold-reserve/ui-cards build:card && pnpm test",
    "check:changed": "node tooling/src/check-changed.mjs",
    "e2e": "playwright test",
    "e2e:site": "playwright test -c playwright.site.config.ts --project site",
    "e2e:changed": "node tooling/src/e2e-changed.mjs",
    "conformance": "node tooling/src/conformance.mjs",
    "mutation": "node tooling/src/mutation.mjs",
    "golden": "node tooling/src/golden.mjs",
    "journey:judge": "node tooling/src/outcomes.mjs journey judge",
    "journey:user": "node tooling/src/outcomes.mjs journey user",
    "journeys": "node tooling/src/outcomes.mjs journeys",
    "outcome": "node tooling/src/outcomes.mjs outcome",
    "outcomes": "node tooling/src/outcomes.mjs all"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "22.20.4",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "stylelint": "17.15.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
