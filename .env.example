# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Spike S6 (spikes/s6-calibration): home location for PVGIS, rounded to 1 decimal.
# Leave both empty to use the placeholder in pvgis-config.json.
PVGIS_LAT=
PVGIS_LON=

# MCP server (apps/mcp-server). Local entry: `pnpm --filter @cold-reserve/mcp-server start` (127.0.0.1 only).
# One bearer token per client, bound to the home it may read: <client>@<homeId>=<token>,...
# Tokens are at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`).
# On Lambda the same value lives in SSM (SecureString) named by MCP_CLIENTS_PARAMETER.
MCP_CLIENTS=
MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173
PORT=3316

# apps/alexa-sim (Vite): all optional, the defaults run the ScriptedAgent offline.
# VITE_AGENT=scripted            # scripted | remote
# VITE_SIM_API_URL=              # required when VITE_AGENT=remote
# VITE_AGENT_TIMEOUT_MS=8000
# VITE_TURN_BUDGET_MS=10000
# VITE_HOME_TIME_ZONE=Europe/Rome  # IANA zone of the home: times on screen use the home's clock

# Agent (apps/agent). Cost rule: the fake model locally and in CI; Bedrock only after Spike S2.
AGENT_MODEL_PROVIDER=fake
# Only with AGENT_MODEL_PROVIDER=bedrock: the model id and region come from config, never from code.
AGENT_MODEL_ID=
AGENT_REGION=
# Ceilings of the cost rule: these may be lowered, never raised.
AGENT_MAX_TOKENS=400
AGENT_MAX_MODEL_TURNS=7
AGENT_MAX_TOOL_CALLS=6
AGENT_HISTORY_WINDOW_MESSAGES=12
AGENT_TURN_DEADLINE_MS=7000
# https, or http only on the loopback. The token is one of the MCP_CLIENTS tokens (32+ characters).
AGENT_MCP_URL=http://127.0.0.1:3316/mcp
AGENT_MCP_TOKEN=
