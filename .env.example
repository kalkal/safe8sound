# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Spike S6 (spikes/s6-calibration): home location for PVGIS, rounded to 1 decimal.
# Leave both empty to use the placeholder in pvgis-config.json.
PVGIS_LAT=
PVGIS_LON=

# MCP server (apps/mcp-server). Local entry: `pnpm --filter @cold-reserve/mcp-server start` (127.0.0.1 only).
# One bearer token per client, bound to the home it may read: <client>@<homeId>=<token>,...
# Tokens are at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`).
# On Lambda the same value lives in SSM (SecureString) named by MCP_CLIENTS_PARAMETER.
MCP_CLIENTS=
MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173
PORT=3316
