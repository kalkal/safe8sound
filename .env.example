# Copy to .env (git-ignored) and fill in locally. Never commit real values.

# Spike S6 (spikes/s6-calibration): home location for PVGIS, rounded to 1 decimal.
# Leave both empty to use the placeholder in pvgis-config.json.
PVGIS_LAT=
PVGIS_LON=

# MCP server (apps/mcp-server). Local entry: `pnpm --filter @cold-reserve/mcp-server start` (127.0.0.1 only).
# One bearer token per client, bound to the home it may read: <client>@<homeId>=<token>,...
# Tokens are at least 32 characters (e.g. `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`).
# `<client>@demo#*=<token>` (the agent's client only) also serves the visitor sandboxes demo#<16 hex>
# named by the x-cold-reserve-home header; any other client sending that header gets 403 home_not_allowed.
# On Lambda the same value lives in SSM (SecureString) named by MCP_CLIENTS_PARAMETER.
# The family phone gets its own token with the phone scope: phone:<role>@demo=<token>, where <role> is the
# registered contact's role (e.g. phone:daughter@demo=<token>). It opens only GET /phone/inbox and
# POST /phone/reply (local entry only; the reply is recorded by that role), never the MCP tools; MCP clients
# cannot read the inbox.
# The agent and the card actions get scopes of their own (#233): agent:agent@demo#*=<token> (every tool call must
# name its turn in x-cold-reserve-turn, or 400) and cards:sim@demo#*=<token> for sim-api (a card action names no
# turn, or 400). Unscoped clients (bench, Inspector) may call any tool with or without a turn.
MCP_CLIENTS=
MCP_ALLOWED_ORIGINS=http://127.0.0.1:5173
# OAuth 2.0 Protected Resource Metadata (RFC 9728, #149): the server's canonical URL, ending with the MCP path.
# When set, GET /.well-known/oauth-protected-resource/mcp serves the document and a 401 names it. https, or
# http only on the loopback. `auto` is for Lambda only (the Function URL domain AWS puts in each request);
# the local entry refuses it, so set the URL itself here.
# MCP_AUTHORIZATION_SERVERS stays empty until an authorization server exists.
# MCP_RESOURCE_URL=http://127.0.0.1:3316/mcp
# MCP_AUTHORIZATION_SERVERS=
PORT=3316

# apps/alexa-sim (Vite): all optional, the defaults run the ScriptedAgent offline.
# VITE_AGENT=scripted            # scripted | remote
# VITE_SIM_API_URL=              # required when VITE_AGENT=remote
# VITE_AGENT_TIMEOUT_MS=8000
# VITE_TURN_BUDGET_MS=10000
# VITE_HOME_TIME_ZONE=Europe/Rome  # IANA zone of the home: times on screen use the home's clock
# The family phone (#24): `scripted` (the scene's messages) or `inbox` (the real GET /phone/inbox).
# VITE_PHONE=scripted
# VITE_PHONE_POLL_MS=5000
# With VITE_PHONE=inbox the Vite dev server proxies /phone/inbox to the MCP server and adds the phone
# token there. NOT VITE_ variables: Vite would put them in the bundle. The token is a phone:<client>@<home>
# entry of MCP_CLIENTS.
# COLD_RESERVE_PHONE_URL=http://127.0.0.1:3316
# COLD_RESERVE_PHONE_TOKEN=

# Agent (apps/agent). Cost rule: the fake model locally and in CI; Bedrock only after Spike S2.
AGENT_MODEL_PROVIDER=fake
# Only with AGENT_MODEL_PROVIDER=bedrock: the model id and region come from config, never from code.
AGENT_MODEL_ID=
AGENT_REGION=
# Ceilings of the cost rule: these may be lowered, never raised.
AGENT_MAX_TOKENS=400
AGENT_MAX_MODEL_TURNS=7
AGENT_MAX_TOOL_CALLS=6
AGENT_HISTORY_WINDOW_MESSAGES=12
AGENT_TURN_DEADLINE_MS=7000
# https, or http only on the loopback. The token is one of the MCP_CLIENTS tokens (32+ characters).
AGENT_MCP_URL=http://127.0.0.1:3316/mcp
AGENT_MCP_TOKEN=
# The token sim-api presents to the agent's /invocations (32+ characters), separate from the MCP token.
AGENT_INVOKE_TOKEN=
# Sandbox homes kept in memory by the local agent (1-1000).
AGENT_MAX_SESSIONS=50
# AgentCore only (docs/agentcore.md): the SSM SecureString that holds the agent's MCP token, read on the
# first invocation; when set, AGENT_MCP_TOKEN is not used. PORT and HOST default to 8080 and 0.0.0.0 there.
# AGENT_MCP_TOKEN_PARAMETER=/cold-reserve/dev/agent/mcp-token
# AGENT_SSM_TIMEOUT_MS=2000

# --- sim-api (apps/sim-api, local entry on 127.0.0.1:3341) ---
# Demo codes as <codeId>:<sha256 hex of the code>; never the codes themselves.
SIM_DEMO_CODES=
# Signing keys as <kid>:<base64url, 32+ bytes>; the first one signs, all of them verify.
SIM_TOKEN_KEYS=
SIM_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Optional locally (#243): when set, only requests carrying it in x-origin-verify are served (on AWS it is always
# set, from SSM, and CloudFront adds it). 32+ characters. Unset: the check is off, said once at start-up.
# SIM_ORIGIN_SECRET=
SIM_TOKEN_TTL_S=3600
SIM_DEMO_ENABLED=true
# Daily caps reset at midnight UTC; code attempts (right or wrong) are counted per client IP per hour.
SIM_LIMIT_TURNS_PER_CODE=20
SIM_LIMIT_TURNS_GLOBAL=30
SIM_LIMIT_TOOL_CALLS_PER_CODE=20
SIM_LIMIT_CODE_ATTEMPTS_PER_IP_HOUR=10
SIM_LIMIT_SPEECH_CHARS_PER_CODE=6000
SIM_LIMIT_SPEECH_CHARS_GLOBAL=30000
# Replies spoken by Amazon Polly (F8d): off locally; Polly runs only in the demo, never in tests or CI.
SIM_SPEECH_ENABLED=false
SIM_SPEECH_ENGINE=neural
SIM_SPEECH_VOICE=Joanna
SIM_AGENT_URL=http://127.0.0.1:3340
SIM_AGENT_TIMEOUT_MS=7500
# The MCP token of a `cards:<client>@demo#*` grant from MCP_CLIENTS (card actions; #233).
SIM_MCP_URL=http://127.0.0.1:3316/mcp
SIM_MCP_TOKEN=
SIM_MCP_TIMEOUT_MS=3000
# The token of a `phone:daughter@demo#*` entry of MCP_CLIENTS (#267): sim-api reads the visitor sandbox's family
# inbox with it for the phone panel. Never sent to the browser. Leave empty to serve no phone route.
SIM_PHONE_TOKEN=
