    {"id":"hot-forecast","category":"hot_day","utterance":"What's the weather looking like for tomorrow?","expect":{"firstToolIn":["get_energy_forecast"]}},
    {"id":"hot-living-room","category":"hot_day","utterance":"Also run the living-room AC all afternoon.","expect":{"firstToolIn":["plan_comfort","get_home_status"]}},
    {"id":"hot-heatwave-plan","category":"hot_day","utterance":"A heatwave is coming this week, can you plan the cooling?","expect":{"firstToolIn":["plan_comfort","get_energy_forecast"]}},
    {"id":"storm-coming","category":"storm","utterance":"A storm is coming tonight.","expect":{"firstToolIn":["start_storm_mode","get_energy_forecast"]}},
    {"id":"storm-outage","category":"storm","utterance":"The power's out","expect":{"firstToolIn":["get_home_status","start_storm_mode"]}},
