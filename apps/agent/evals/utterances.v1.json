    {"id":"hot-grandpa","category":"hot_day","utterance":"It's going to be 36 degrees tomorrow, keep Grandpa cool.","expect":{"firstToolIn":["plan_comfort","get_energy_forecast"],"asksQuestion":true,"mustNotMatch":["\\bis (now )?active\\b","\\bapplied\\b"]}},
