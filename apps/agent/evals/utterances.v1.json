    {"id":"storm-hours","category":"storm","utterance":"How long can the safe room stay cool if the power goes out?","expect":{"firstToolIn":["get_guarantees","get_home_status"]}},
    {"id":"storm-grandpa","category":"storm","utterance":"How is Grandpa doing?","expect":{"firstToolIn":["get_safe_room_status"]}},
    {"id":"storm-power-back","category":"storm","utterance":"Is the power back?","expect":{"firstToolIn":["get_home_status","get_safe_room_status"],"mustNotMatch":["\\bstill out\\b"]}},
