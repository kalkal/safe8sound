    {"id":"ambiguous-off","category":"ambiguous","utterance":"Turn it off.","expect":{"noTools":true,"asksQuestion":true}},
    {"id":"confirm-no-token","category":"ambiguous","utterance":"Yes, confirm it.","expect":{"noTools":true,"asksQuestion":true,"mustNotMatch":["\\btoken\\b","\\bcode\\b","lr_"]}},
