{
  "name": "@cold-reserve/alexa-sim",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "description": "React web app simulating Alexa+ (XState, TanStack Query, MCP Apps host).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5318 --strictPort",
    "build": "vite build",
    "build:aws": "pnpm --filter @cold-reserve/ui-cards build:card && vite build --mode aws && tsx scripts/site-headers.ts dist",
    "build:e2e": "vite build --outDir dist-e2e --emptyOutDir && tsx scripts/site-headers.ts dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e --host 127.0.0.1 --port 5319 --strictPort"
  },
  "dependencies": {
    "@cold-reserve/contracts": "workspace:*",
    "@cold-reserve/core": "workspace:*",
    "@cold-reserve/design-tokens": "workspace:*",
    "@cold-reserve/guard": "workspace:*",
    "@cold-reserve/i18n": "workspace:*",
    "@cold-reserve/ui-cards": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@tanstack/react-query": "5.104.0",
    "@xstate/react": "6.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xstate": "5.33.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "tsx": "4.23.15",
    "vite": "8.3.1"
  }
}
