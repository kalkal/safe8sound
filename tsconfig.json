{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "infra/**/*.ts",
    "tooling/**/*.ts",
    "tooling/**/*.mjs",
    "e2e/**/*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/cdk.out",
    "packages/ui-cards",
    "apps/alexa-sim",
    "tooling/test/fixtures"
  ]
}
